{
  "version": 2,
  "builds": [
    {
      "src": "api/health.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/market.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/funds.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/sync-funds.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/predict.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/performance.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/debug-tefas.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/debug-market.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "data/funds.json",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/health",
      "dest": "/api/health.js"
    },
    {
      "src": "/api/market",
      "dest": "/api/market.js"
    },
    {
      "src": "/api/funds",
      "dest": "/api/funds.js"
    },
    {
      "src": "/api/sync-funds",
      "dest": "/api/sync-funds.js"
    },
    {
      "src": "/api/predict",
      "dest": "/api/predict.js"
    },
    {
      "src": "/api/performance",
      "dest": "/api/performance.js"
    },
    {
      "src": "/api/debug-tefas",
      "dest": "/api/debug-tefas.js"
    },
    {
      "src": "/api/debug-market",
      "dest": "/api/debug-market.js"
    },
    {
      "src": "/data/funds.json",
      "dest": "/data/funds.json"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/sync-funds",
      "schedule": "30 7 * * 1-5"
    },
    {
      "path": "/api/predict",
      "schedule": "40 7 * * 1-5"
    },
    {
      "path": "/api/sync-funds",
      "schedule": "30 10 * * 1-5"
    },
    {
      "path": "/api/predict",
      "schedule": "40 10 * * 1-5"
    },
    {
      "path": "/api/sync-funds",
      "schedule": "30 13 * * 1-5"
    },
    {
      "path": "/api/predict",
      "schedule": "40 13 * * 1-5"
    },
    {
      "path": "/api/sync-funds",
      "schedule": "30 15 * * 1-5"
    },
    {
      "path": "/api/predict",
      "schedule": "40 15 * * 1-5"
    }
  ]
}
