{
  "version": 2,
  "builds": [
    {
      "src": "api/health.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/market.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/funds.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/sync-funds.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/predict.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/debug-tefas.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "data/funds.json",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/health",
      "dest": "/api/health.js"
    },
    {
      "src": "/api/market",
      "dest": "/api/market.js"
    },
    {
      "src": "/api/funds",
      "dest": "/api/funds.js"
    },
    {
      "src": "/api/sync-funds",
      "dest": "/api/sync-funds.js"
    },
    {
      "src": "/api/predict",
      "dest": "/api/predict.js"
    },
    {
      "src": "/api/debug-tefas",
      "dest": "/api/debug-tefas.js"
    },
    {
      "src": "/data/funds.json",
      "dest": "/data/funds.json"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/sync-funds",
      "schedule": "0 18 * * 1-5"
    }
  ]
}
